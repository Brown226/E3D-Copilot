<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <RootNamespace>E3DCopilot.Core</RootNamespace>
    <AssemblyName>E3DCopilot.Core</AssemblyName>
    <OutputType>Library</OutputType>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="1.0.0" />
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="5.0.0" />
    <PackageReference Include="netDxf" Version="2023.11.10" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Net.Http" />
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="CNPE.ISO.E3D.Core">
      <HintPath>..\..\lib\iso\CNPE.ISO.E3D.Core.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="CNPE.ISO.Model">
      <HintPath>..\..\lib\iso\CNPE.ISO.Model.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="CNPE.ISO.CAD.Core">
      <HintPath>..\..\lib\iso\CNPE.ISO.CAD.Core.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="CNPE.ISO.E3D">
      <HintPath>..\..\lib\iso\CNPE.ISO.E3D.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <!-- Teigha.NET (DWG/DXF 离线解析) -->
  <ItemGroup>
    <Reference Include="TD_Mgd_4.00_10">
      <HintPath>..\..\lib\Teigha\TD_Mgd_4.00_10.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <!-- E3D API References -->
  <ItemGroup>
    <Reference Include="Aveva.Core">
      <HintPath>..\..\lib\e3d\Aveva.Core.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Aveva.Core.Database">
      <HintPath>..\..\lib\e3d\Aveva.Core.Database.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Aveva.Core.Geometry">
      <HintPath>..\..\lib\e3d\Aveva.Core.Geometry.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Aveva.Core.Global">
      <HintPath>..\..\lib\e3d\Aveva.Core.Global.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Aveva.ApplicationFramework">
      <HintPath>..\..\lib\e3d\Aveva.ApplicationFramework.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\SharedAssemblyInfo.cs" />
  </ItemGroup>

  <!-- 内置 skills 目录：仅复制 SKILL.md 到输出目录，供 SkillManager 扫描 -->
  <!-- 注意：Windows 文件系统不区分大小写，skills\** 会同时匹配 Skills\ 下的 .cs 文件，
       因此用精确的 SKILL.md 文件名匹配，避免把源代码复制到输出目录 -->
  <ItemGroup>
    <Content Include="skills\**\SKILL.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
